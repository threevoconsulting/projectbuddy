# Copy to .env and adjust. All settings are optional; defaults run the fully-faked
# stack (no models needed), which is what CI and the cloud dev container use.

# --- Server ---
PB_HOST=127.0.0.1
PB_PORT=8765

# --- Model backends: "fake" (default, no models) or the real adapter ---
PB_LLM_BACKEND=fake          # fake | ollama
PB_STT_BACKEND=fake          # fake | faster_whisper
PB_TTS_BACKEND=fake          # fake | piper (fast) | kokoro (warm, natural — best for kids)
PB_RECOGNITION_BACKEND=fake  # fake | insightface
PB_LIVENESS_BACKEND=fake     # fake (permissive) | minifasnet (anti-spoof)

# --- Ollama (only used when PB_LLM_BACKEND=ollama) ---
PB_OLLAMA_URL=http://localhost:11434
PB_OLLAMA_MODEL=qwen3:8b     # smaller models (llama3.2:3b, gemma3:4b) reply faster
PB_LLM_NUM_CTX=2048          # smaller context = faster prompt processing
PB_LLM_NUM_PREDICT=128       # cap reply length (Buddy speaks 1-3 short sentences)
PB_LLM_KEEP_ALIVE=30m        # keep the model warm between turns (no reload delay)

# --- faster-whisper STT (only used when PB_STT_BACKEND=faster_whisper) ---
PB_WHISPER_MODEL=base          # tiny | base | small
PB_WHISPER_DEVICE=cpu
PB_WHISPER_COMPUTE_TYPE=int8
PB_WHISPER_LANGUAGE=en

# --- Piper TTS (only used when PB_TTS_BACKEND=piper) ---
PB_PIPER_BINARY=piper
# Warmer of the two Piper voices pull_models.sh downloads to ./models/piper/
PB_PIPER_VOICE_PATH=./models/piper/en_US-amy-medium.onnx

# --- Kokoro TTS (only used when PB_TTS_BACKEND=kokoro; a more lifelike voice) ---
PB_KOKORO_VOICE=af_heart      # see the Kokoro voice list
PB_KOKORO_LANG=a              # 'a' = American English

# --- Face recognition (only used when PB_RECOGNITION_BACKEND=insightface) ---
PB_INSIGHTFACE_MODEL=buffalo_l
PB_INSIGHTFACE_DEVICE=cpu          # cpu | cuda
PB_RECOGNITION_MATCH_THRESHOLD=0.45 # cosine; higher = stricter (avoid sibling mix-ups)

# --- Liveness / anti-spoof (only used when PB_LIVENESS_BACKEND=minifasnet) ---
PB_LIVENESS_MODEL=                  # path to a MiniFASNet .onnx (required for the real backend)
PB_LIVENESS_DEVICE=cpu              # cpu | cuda
PB_LIVENESS_THRESHOLD=0.5           # P(real) needed to accept a frame

# --- Data ---
PB_DB_PATH=buddy.db
